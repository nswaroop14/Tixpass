APP_URL=http://localhost:5000
SESSION_SECRET=dev-session-secret-change-me

# Database (Neon/Postgres) connection string
# Example: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST/YOUR_DB?sslmode=require

# SMTP (optional for local; if omitted, email sending is skipped)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TixPass" <no-reply@tixpass.com>
